<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/backgrdimg"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- ===================================================== -->
        <!-- TOOLBAR -->
        <!-- ===================================================== -->

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@android:color/transparent"
            android:paddingTop="35dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:title="Add Yard"
            app:titleCentered="true"
            app:titleTextColor="@android:color/white"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:navigationIcon="@drawable/baseline_arrow_back_24"
            app:navigationIconTint="@android:color/white" />

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp">

            <!-- Yard Icon -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="82dp"
                android:layout_height="82dp"
                app:cardBackgroundColor="#F59E0B"
                app:cardCornerRadius="41dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp"
                    android:src="@drawable/baseline_warehouse_24"
                    android:contentDescription="Yard"
                    app:tint="@android:color/white" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Add New Yard"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Enter the yard details below to add a new storage location."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- MAIN FORM CARD -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ================================================= -->
                <!-- SECTION HEADER -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="25dp"
                        android:background="#F59E0B" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yard Information"
                            android:textColor="#172033"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Provide the basic details of the yard"
                            android:textColor="#7A8496"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ================================================= -->
                <!-- YARD SELECTION -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilYardDropdown"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Select Yard"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="#172033"
                    app:startIconDrawable="@drawable/baseline_warehouse_24">

                    <AutoCompleteTextView
                        android:id="@+id/actvYard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:textSize="14sp"
                        android:textColor="#172033"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ================================================= -->
                <!-- OTHER YARD NAME -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOtherYardName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Enter Yard Name"
                    android:visibility="gone"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:startIconDrawable="@drawable/baseline_warehouse_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtOtherYardName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textSize="14sp"
                        android:textColor="#172033"
                        android:maxLines="1"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ================================================= -->
                <!-- ADDRESS -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Yard Address"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:startIconDrawable="@drawable/baseline_location_pin_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtYardAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords|textMultiLine"
                        android:textSize="14sp"
                        android:textColor="#172033"
                        android:minLines="2"
                        android:maxLines="3"
                        android:gravity="top"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ================================================= -->
                <!-- MANAGER -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Yard Manager Name"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:startIconDrawable="@drawable/baseline_person_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtYardManager"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textSize="14sp"
                        android:textColor="#172033"
                        android:maxLines="1"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ================================================= -->
                <!-- MOBILE -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Mobile Number"
                    app:prefixText="+91 "
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:startIconDrawable="@drawable/baseline_call_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtYardContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textSize="14sp"
                        android:textColor="#172033"
                        android:maxLength="10"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ================================================= -->
                <!-- REQUIRED FIELD NOTE -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/outline_check_circle_24"
                        android:contentDescription="Information"
                        app:tint="#64748B" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Make sure the yard details are correct before saving."
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- ================================================= -->
                <!-- SAVE BUTTON -->
                <!-- ================================================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveYard"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Save Yard"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#172033"
                    app:cornerRadius="16dp"
                    app:elevation="2dp"
                    app:icon="@drawable/baseline_save_24"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@android:color/white" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>