<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="@android:color/white">


    <!-- ================================================= -->
    <!-- TOOLBAR -->
    <!-- ================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"

        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"

        app:title="Upload Vehicle Images"
        app:titleTextColor="@android:color/black"

        app:navigationIcon="@drawable/baseline_arrow_back_24"
        app:navigationIconTint="@color/black"/>


    <!-- ================================================= -->
    <!-- SCROLL VIEW -->
    <!-- ================================================= -->

    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="16dp">


            <!-- ========================================= -->
            <!-- VEHICLE NUMBER -->
            <!-- ========================================= -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Vehicle Number"

                android:textStyle="bold"
                android:textSize="14sp"/>


            <TextView

                android:id="@+id/txtVehicleNumber"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="MH14AB1234"

                android:textSize="20sp"
                android:textStyle="bold"/>


            <!-- ========================================= -->
            <!-- STATUS -->
            <!-- ========================================= -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:text="Selected Status"

                android:textStyle="bold"
                android:textSize="14sp"/>


            <TextView

                android:id="@+id/txtSelectedStatus"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="repo mark"

                android:textSize="18sp"
                android:textStyle="bold"/>


            <!-- ================================================= -->
            <!-- INVENTORY -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"

                android:text="Inventory Images"

                android:textSize="20sp"
                android:textStyle="bold"/>


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Select exactly 2 inventory images"

                android:textSize="13sp"/>


            <!-- Select inventory button -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnSelectInventory"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:backgroundTint="#002147"

                android:text="SELECT 2 INVENTORY IMAGES"

                android:textColor="@android:color/white"/>


            <!-- Inventory images -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:orientation="horizontal">


                <ImageView

                    android:id="@+id/imgInventory1"

                    android:layout_width="0dp"
                    android:layout_height="160dp"

                    android:layout_weight="1"

                    android:layout_marginEnd="6dp"

                    android:background="#EEEEEE"

                    android:scaleType="centerCrop"

                    android:src="@drawable/outline_image_24"/>


                <ImageView

                    android:id="@+id/imgInventory2"

                    android:layout_width="0dp"
                    android:layout_height="160dp"

                    android:layout_weight="1"

                    android:layout_marginStart="6dp"

                    android:background="#EEEEEE"

                    android:scaleType="centerCrop"

                    android:src="@drawable/outline_image_24"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- VEHICLE IMAGES -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="32dp"

                android:text="Vehicle Images"

                android:textSize="20sp"
                android:textStyle="bold"/>


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Select exactly 5 vehicle images"

                android:textSize="13sp"/>


            <!-- Select vehicle button -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnSelectVehicle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:backgroundTint="#002147"

                android:text="SELECT 5 VEHICLE IMAGES"

                android:textColor="@android:color/white"/>


            <!-- Vehicle image 1 -->

            <ImageView

                android:id="@+id/imgVehicle1"

                android:layout_width="match_parent"
                android:layout_height="180dp"

                android:layout_marginTop="12dp"

                android:background="#EEEEEE"

                android:scaleType="centerCrop"

                android:src="@drawable/outline_image_24"/>


            <!-- Vehicle image 2 -->

            <ImageView

                android:id="@+id/imgVehicle2"

                android:layout_width="match_parent"
                android:layout_height="180dp"

                android:layout_marginTop="12dp"

                android:background="#EEEEEE"

                android:scaleType="centerCrop"

                android:src="@drawable/outline_image_24"/>


            <!-- Vehicle image 3 -->

            <ImageView

                android:id="@+id/imgVehicle3"

                android:layout_width="match_parent"
                android:layout_height="180dp"

                android:layout_marginTop="12dp"

                android:background="#EEEEEE"

                android:scaleType="centerCrop"

                android:src="@drawable/outline_image_24"/>


            <!-- Vehicle image 4 -->

            <ImageView

                android:id="@+id/imgVehicle4"

                android:layout_width="match_parent"
                android:layout_height="180dp"

                android:layout_marginTop="12dp"

                android:background="#EEEEEE"

                android:scaleType="centerCrop"

                android:src="@drawable/outline_image_24"/>


            <!-- Vehicle image 5 -->

            <ImageView

                android:id="@+id/imgVehicle5"

                android:layout_width="match_parent"
                android:layout_height="180dp"

                android:layout_marginTop="12dp"

                android:background="#EEEEEE"

                android:scaleType="centerCrop"

                android:src="@drawable/outline_image_24"/>


            <!-- ================================================= -->
            <!-- IMAGE SIZE INFORMATION -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:gravity="center"

                android:text="Images will automatically be compressed to maximum 200 KB"

                android:textSize="12sp"

                android:textColor="#666666"/>


            <!-- ================================================= -->
            <!-- PROGRESS -->
            <!-- ================================================= -->

            <ProgressBar

                android:id="@+id/progressBar"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center"

                android:layout_marginTop="24dp"

                android:visibility="gone"/>


            <!-- ================================================= -->
            <!-- SUBMIT -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnSubmit"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"
                android:layout_marginBottom="30dp"

                android:backgroundTint="#002147"

                android:text="SUBMIT"

                android:textColor="@android:color/white"

                android:textSize="16sp"/>


        </LinearLayout>

    </ScrollView>

</LinearLayout>