<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".activities.AdminDashboardActivity">

    <!-- =========================
         MAIN CONTENT
         ========================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/backgrdimg">

        <!-- =========================
             TOOLBAR
             ========================= -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:paddingStart="18dp"
            android:paddingTop="35dp"
            app:navigationIcon="@drawable/baseline_arrow_back_24"
            android:paddingEnd="18dp"
            app:title="Repo Master"
            app:titleTextColor="#172033"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:navigationIconTint="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- =========================
             SCROLL CONTENT
             ========================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboardScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- =========================
                     GREETING
                     ========================= -->
                <TextView
                    android:id="@+id/txtGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans"
                    android:text="Welcome, Admin 👋"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Here's what's happening in your repossession operations."
                    android:textColor="#FFA500"
                    android:textSize="14sp" />

                <!-- =========================
                     HERO / VEHICLE OPERATIONS
                     ========================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardViewVehicle1"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="22dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="22dp">

                        <!-- Decorative circle -->


                        <LinearLayout
                            android:id="@+id/vehicleIconContainer"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_orange_circle"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="Vehicle"
                                android:src="@drawable/outline_directions_car_24" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtVehicleOperations"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Vehicle Operations"
                            android:textColor="@color/status_parked"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/vehicleIconContainer"
                            app:layout_constraintTop_toTopOf="@id/vehicleIconContainer" />

                        <TextView
                            android:id="@+id/txtVehicleDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Search, monitor and manage your repossession vehicles."
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/vehicleIconContainer"
                            app:layout_constraintTop_toBottomOf="@id/vehicleIconContainer" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================
                     OVERVIEW TITLE
                     ========================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Overview"
                        android:textColor="#FFA500"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dashboard"
                        android:textColor="#8A94A6"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- =========================
                     OVERVIEW CARDS
                     ========================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Vehicles -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#E9EDF3"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:contentDescription="Vehicles"
                                    android:src="@drawable/outline_directions_car_24" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Vehicles"
                                    android:textColor="#6B7280"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtTotalVehicles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="—"
                                android:textColor="#172033"
                                android:textSize="25sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total records"
                                android:textColor="@color/red"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- Pending -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#E9EDF3"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:contentDescription="Pending"
                                    android:src="@drawable/baseline_pending_24" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Pending"
                                    android:textColor="#6B7280"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtPendingUsers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="—"
                                android:textColor="#172033"
                                android:textSize="25sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agent requests"
                                android:textColor="@color/red"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- =========================
                     QUICK ACTIONS TITLE
                     ========================= -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="Quick Actions"
                    android:textColor="#172033"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Common tasks at your fingertips"
                    android:textColor="@color/white"
                    android:textSize="12sp" />


                <!-- =========================
                     ADD VEHICLE
                     ========================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAddVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E9EDF3"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <LinearLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_blue_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Add vehicle"
                                android:src="@drawable/orange_directions_car_24"
                                app:tint="@color/white"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add Vehicle"
                                android:textColor="#172033"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Register a new vehicle"
                                android:textColor="#8A94A6"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Open"
                            android:src="@drawable/baseline_arrow_forward_24" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================
                     VIEW VEHICLES
                     ========================= -->
                <com.google.android.material.card.MaterialCardView
                   android:id="@+id/cardViewVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E9EDF3"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <LinearLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_green_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="View vehicles"
                                android:src="@drawable/white_visibility_24" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View Vehicles"
                                android:textColor="#172033"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Search and manage vehicles"
                                android:textColor="#8A94A6"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Open"
                            android:src="@drawable/baseline_arrow_forward_24" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================
                     AGENT REQUESTS
                     ========================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUpdateVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E9EDF3"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <LinearLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_orange_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Agent requests"
                                android:src="@drawable/outline_group_24" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agent Requests"
                                android:textColor="#172033"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Review pending user approvals"
                                android:textColor="#8A94A6"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPendingBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="9dp"
                            android:background="@drawable/bg_orange_circle"
                            android:gravity="center"
                            android:minWidth="30dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="!"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Open"
                            android:src="@drawable/baseline_arrow_forward_24" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================
                     SEARCH HISTORY
                     ========================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSearchHistory"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E9EDF3"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <LinearLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_red_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Search history"
                                android:src="@drawable/baseline_history_24"
                                app:tint="@color/white"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Search History"
                                android:textColor="#172033"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Review vehicle search activity"
                                android:textColor="#8A94A6"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Open"
                            android:src="@drawable/baseline_arrow_forward_24" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================
                     BULK UPLOAD
                     ========================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBulkUpload"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E9EDF3"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <LinearLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_purple_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Bulk upload"
                                android:src="@drawable/outline_upload_file_24" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bulk Upload"
                                android:textColor="#172033"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Import vehicles using Excel"
                                android:textColor="#8A94A6"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Open"
                            android:src="@drawable/baseline_arrow_forward_24" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================
                     REPORTS
                     ========================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReports"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E9EDF3"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <LinearLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_teal_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Reports"
                                android:src="@drawable/outline_analytics_24" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reports And Analytics"
                                android:textColor="#172033"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="View performance and activity reports"
                                android:textColor="#8A94A6"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Open"
                            android:src="@drawable/baseline_arrow_forward_24" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================
                     BOTTOM SPACE
                     ========================= -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =========================
         NAVIGATION DRAWER
         ========================= -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:elevation="12dp"
        app:headerLayout="@layout/nav_header"
