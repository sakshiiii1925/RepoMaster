<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgrdimg">

    <!-- ===================================================== -->
    <!-- MAIN CONTENT                                          -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ================================================= -->
        <!-- TOOLBAR                                            -->
        <!-- ================================================= -->

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:background="@android:color/transparent"
            android:elevation="3dp"
            android:paddingTop="35dp"
            android:title="Activity Details"
            android:titleTextColor="#172033"
            android:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:navigationIcon="@drawable/baseline_arrow_back_24"
            app:navigationIconTint="#FFFFFF" />

        <!-- ================================================= -->
        <!-- SCROLL CONTENT                                     -->
        <!-- ================================================= -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="28dp">

                <!-- ========================================= -->
                <!-- VEHICLE HEADER CARD                       -->
                <!-- ========================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E4E8EE"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Vehicle label -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VEHICLE ACTIVITY"
                            android:textColor="#7A8494"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <!-- Vehicle number -->

                        <TextView
                            android:id="@+id/txtVehicleNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="MH12CD6666"
                            android:textColor="#172033"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <!-- Divider -->

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="#EEF1F5" />

                        <!-- User -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_orange_circle"
                                android:contentDescription="User"
                                android:padding="9dp"
                                android:src="@drawable/baseline_person_24"
                                app:tint="#002147" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Uploaded By"
                                    android:textColor="#7A8494"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/txtUserName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="User"
                                    android:textColor="#172033"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Email -->

                        <TextView
                            android:id="@+id/txtUserEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="52dp"
                            android:layout_marginTop="5dp"
                            android:text="user@gmail.com"
                            android:textColor="#697386"
                            android:textSize="13sp" />

                        <!-- Status -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Current Status"
                                android:textColor="#697386"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/txtStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:paddingStart="14dp"
                                android:paddingTop="7dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="7dp"
                                android:text="Parked"
                                android:textColor="#166534"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================================= -->
                <!-- INVENTORY SECTION                         -->
                <!-- ========================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inventory Images"
                            android:textColor="@color/white"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Uploaded inventory condition"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="2 Photos"
                        android:textColor="#002147"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Inventory Image 1 -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E4E8EE"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/imageInventory1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#EEF1F5"
                        android:contentDescription="Inventory Image 1"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>


                <!-- Inventory Image 2 -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E4E8EE"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/imageInventory2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#EEF1F5"
                        android:contentDescription="Inventory Image 2"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================================= -->
                <!-- VEHICLE SECTION                            -->
                <!-- ========================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicle Images"
                            android:textColor="#172033"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Vehicle condition photos"
                            android:textColor="#7A8494"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="5 Photos"
                        android:textColor="#002147"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Vehicle Image 1 -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E4E8EE"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/imageVehicle1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#EEF1F5"
                        android:contentDescription="Vehicle Image 1"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>


                <!-- Vehicle Image 2 -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E4E8EE"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/imageVehicle2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#EEF1F5"
                        android:contentDescription="Vehicle Image 2"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>


                <!-- Vehicle Image 3 -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E4E8EE"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/imageVehicle3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#EEF1F5"
                        android:contentDescription="Vehicle Image 3"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>


                <!-- Vehicle Image 4 -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E4E8EE"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/imageVehicle4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#EEF1F5"
                        android:contentDescription="Vehicle Image 4"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>


                <!-- Vehicle Image 5 -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E4E8EE"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/imageVehicle5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#EEF1F5"
                        android:contentDescription="Vehicle Image 5"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- LOADING OVERLAY                                       -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/progressDetails"
                    android:layout_width="42dp"
                    android:layout_height="42dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Loading..."
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</FrameLayout>

