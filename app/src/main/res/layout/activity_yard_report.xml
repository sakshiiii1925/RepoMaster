<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/backgrdimg">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@android:color/transparent"
        android:title="Yard Report"
        android:titleTextColor="@android:color/white"
        android:paddingTop="40dp"
        app:navigationIcon="@drawable/baseline_arrow_back_24" />

    <!-- Title -->

    <!-- Select Yard -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/yardDropdownLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:hint="Select Yard"
        app:boxBackgroundColor="@color/white"
        android:outlineAmbientShadowColor="@color/white"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/white"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/autoYard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:padding="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Selected Yard -->
    <TextView
        android:id="@+id/txtSelectedYard"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Selected Yard: None"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Vehicle Count -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp">
    <TextView
        android:id="@+id/txtVehicleCount"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Vehicles: 0"
        android:clickable="true"
        android:background="@drawable/yard_summary_card"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
        <TextView
            android:id="@+id/txtRepoMarked"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:layout_marginStart="10dp"
            android:text="Repo Marked: 0"
            android:background="@drawable/yard_summary_card"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp">
        <TextView
            android:id="@+id/txtParked"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:text="Parked: 0"
            android:background="@drawable/yard_summary_card"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtReleased"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:layout_marginStart="20dp"
            android:text="Released: 0"
            android:background="@drawable/yard_summary_card"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
    <!-- Vehicle Table -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <!-- Vertical Scroll -->
        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TableLayout
                android:id="@+id/tableVehicleReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- HEADER ROW -->
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="55dp">

                    <!-- Sr -->
                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Sr."
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/table_cell_border" />

                    <!-- Vehicle Number -->
                    <TextView
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Vehicle Number"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/table_cell_border" />
                    <TextView
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Status"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/table_cell_border" />

                </TableRow>

            </TableLayout>

        </ScrollView>

    </HorizontalScrollView>

    <!-- Download Buttons -->
    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp">

        <!-- PDF -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadPdf"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="PDF"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#E53935"
            app:icon="@drawable/baseline_picture_as_pdf_24" />

        <!-- Excel -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadExcel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Excel"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:backgroundTint="#43A047"
            app:icon="@drawable/ic_excel" />

    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressYardReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center" />

</LinearLayout>